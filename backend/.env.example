# Copy to .env for local development. NEVER commit .env. In production use a secret manager.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
PUBLIC_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# Production only: the private IP ranges of your load balancer / reverse proxy (comma separated).
TRUSTED_PROXY_CIDRS=
# Serve ../frontend from the API in development (production serves it from the CDN).
SERVE_FRONTEND=true

DATABASE_URL=postgres://kagobuild:kagobuild@localhost:5432/kagobuild
DB_POOL_MAX=12
REDIS_URL=redis://localhost:6379

# Supabase Auth: use a project with asymmetric (RS256/ES256) JWT signing keys.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
AUTH_EMAIL_REDIRECT_URL=http://localhost:3000/pages/signin.html
# Throwaway (temporary/disposable) email addresses are refused at sign-up, login and reset, and on every
# signed-in request. Optional comma-separated extras, and an allow-list if a real domain is ever wrongly listed.
DISPOSABLE_EMAIL_EXTRA_DOMAINS=
DISPOSABLE_EMAIL_ALLOW_DOMAINS=
# Admins must sign in with MFA. Defaults to true in production.
ADMIN_REQUIRE_MFA=false

# Payments (Paystack). Keep BILLING_ENABLED=false until sandbox testing is signed off.
BILLING_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3000/pages/premium.html

# AI: 'template' needs no key (rule-based layouts). 'openai-compatible' calls any /chat/completions API
# that supports JSON-schema structured output.
AI_ENABLED=true
AI_PROVIDER=template
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=30000
AI_FREE_MONTHLY_GENERATIONS=3

# Price changes larger than this (basis points; 1000 = 10%) need a second admin's approval.
PRICE_REVIEW_THRESHOLD_BP=1000
