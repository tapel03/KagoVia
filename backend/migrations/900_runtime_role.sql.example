-- NOT applied automatically (the migration runner only reads *.sql). Run once per environment as an admin,
-- after replacing the password. The API and worker connect as kagobuild_app; migrations run as the owner.
-- Least privilege (Deployment guide step 4): no DDL, no DELETE on money tables, audit log is append-only.

CREATE ROLE kagobuild_app LOGIN PASSWORD 'CHANGE-ME';
GRANT USAGE ON SCHEMA public TO kagobuild_app;
GRANT SELECT, INSERT, UPDATE ON ALL TABLES IN SCHEMA public TO kagobuild_app;
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO kagobuild_app;

-- Append-only / immutable records.
REVOKE UPDATE ON audit_log, price_history, payment_events, chat_messages FROM kagobuild_app;
-- payment_events.outcome is set once right after insert inside the same transaction:
GRANT UPDATE (outcome) ON payment_events TO kagobuild_app;

-- No deletes, except rows the app legitimately removes.
GRANT DELETE ON user_roles TO kagobuild_app;
